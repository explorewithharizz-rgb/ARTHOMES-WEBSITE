{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/nx-admin", "destination": "/nx-admin.html" },
    { "source": "/nx-admin/(.*)", "destination": "/nx-admin.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
